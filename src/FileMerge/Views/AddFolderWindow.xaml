<Window x:Class="FileMerge.Views.AddFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileMerge.Localization"
        Title="{loc:T Folder.Title}"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FlowDirection="{Binding Source={x:Static loc:Loc.Current}, Path=FlowDirection}">

    <StackPanel Margin="22">
        <TextBlock Text="{loc:T Folder.Path}" Style="{StaticResource LabelText}" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Grid.Column="0" TextChanged="OnTextChanged" />
            <Button Grid.Column="1"
                    Style="{StaticResource BaseButton}"
                    Content="{loc:T Action.Browse}"
                    Click="OnBrowse"
                    Margin="8,0,0,0" />
        </Grid>

        <TextBlock Text="{loc:T Folder.Filter}" Style="{StaticResource LabelText}" />
        <TextBox x:Name="FilterBox" TextChanged="OnTextChanged" />
        <TextBlock Text="{loc:T Folder.FilterHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />

        <CheckBox x:Name="RecursiveBox" Content="{loc:T Folder.Recursive}" Click="OnToggleChanged" />
        <CheckBox x:Name="HiddenBox" Content="{loc:T Folder.IncludeHidden}" Click="OnToggleChanged" />

        <TextBlock x:Name="FoundText"
                   Style="{StaticResource CaptionText}"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource BaseButton}"
                    Content="{loc:T Common.Cancel}"
                    Click="OnCancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button x:Name="AddButton"
                    Style="{StaticResource AccentButton}"
                    Content="{loc:T Action.Add}"
                    Click="OnAdd"
                    MinWidth="110"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
