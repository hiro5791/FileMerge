<Window x:Class="FileMerge.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileMerge.Converters"
        xmlns:loc="clr-namespace:FileMerge.Localization"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FlowDirection="{Binding Source={x:Static loc:Loc.Current}, Path=FlowDirection}">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <StackPanel Margin="22">
        <TextBlock x:Name="HeadlineText"
                   Style="{StaticResource SectionText}"
                   FontSize="15"
                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVis}}" />

        <TextBlock x:Name="BodyText"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   Margin="0,2,0,0" />

        <Border x:Name="DetailBox"
                Background="{DynamicResource SubtleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,14,0,0"
                Visibility="Collapsed">
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" Style="{StaticResource CaptionText}" />
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="TertiaryButton"
                    Style="{StaticResource BaseButton}"
                    Click="OnTertiary"
                    Visibility="Collapsed"
                    Margin="0,0,8,0" />
            <Button x:Name="SecondaryButton"
                    Style="{StaticResource BaseButton}"
                    Click="OnSecondary"
                    Visibility="Collapsed"
                    MinWidth="90"
                    Margin="0,0,8,0" />
            <Button x:Name="PrimaryButton"
                    Style="{StaticResource AccentButton}"
                    Click="OnPrimary"
                    MinWidth="90"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
