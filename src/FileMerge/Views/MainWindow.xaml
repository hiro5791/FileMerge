<Window x:Class="FileMerge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileMerge.Converters"
        xmlns:loc="clr-namespace:FileMerge.Localization"
        xmlns:vm="clr-namespace:FileMerge.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1080" Height="720"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FlowDirection="{Binding Source={x:Static loc:Loc.Current}, Path=FlowDirection}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        Closing="OnClosing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <conv:InverseBoolConverter x:Key="NotBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:FileSizeConverter x:Key="SizeFormat" />
        <conv:DateTimeConverter x:Key="DateFormat" />

        <!-- DisplayMemberPath does not reach the closed combo box through this custom
             template, so every list binds an explicit item template instead. -->
        <DataTemplate x:Key="OptionTemplate">
            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="LanguageTemplate">
            <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18,4,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header. The name and version live in the title bar, so this is only the pickers. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Settings.Theme}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Width="130"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          ItemTemplate="{StaticResource OptionTemplate}" />

                <TextBlock Text="{loc:T Settings.Language}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="18,0,8,0" />
                <ComboBox Width="170"
                          MaxDropDownHeight="420"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          ItemTemplate="{StaticResource LanguageTemplate}" />
            </StackPanel>
        </Grid>

        <!-- ============================================== Body -->
        <Grid Grid.Row="1">
            <!-- File list, the full width of the window -->
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Style="{StaticResource BaseButton}"
                                Content="{loc:T Action.AddFiles}"
                                Command="{Binding AddFilesCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource BaseButton}"
                                Content="{loc:T Action.AddFolder}"
                                Command="{Binding AddFolderCommand}"
                                Margin="0,0,14,6" />

                        <Button Style="{StaticResource SubtleButton}"
                                Content="&#x25B2;"
                                ToolTip="{loc:T Action.MoveUp}"
                                Command="{Binding MoveUpCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=FileList}"
                                Margin="0,0,4,6" />
                        <Button Style="{StaticResource SubtleButton}"
                                Content="&#x25BC;"
                                ToolTip="{loc:T Action.MoveDown}"
                                Command="{Binding MoveDownCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=FileList}"
                                Margin="0,0,10,6" />

                        <Button x:Name="SortButton"
                                Style="{StaticResource BaseButton}"
                                Content="{loc:T Action.Sort}"
                                Click="OnSortClick"
                                Margin="0,0,14,6" />

                        <Button Style="{StaticResource BaseButton}"
                                Content="{loc:T Action.Remove}"
                                Command="{Binding RemoveCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=FileList}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource BaseButton}"
                                Content="{loc:T Action.ClearAll}"
                                Command="{Binding ClearAllCommand}"
                                Margin="0,0,0,6" />
                    </WrapPanel>

                    <Popup x:Name="SortPopup"
                           PlacementTarget="{Binding ElementName=SortButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource LayerBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,4,10,10"
                                Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Direction="270" />
                            </Border.Effect>
                            <!-- Sized to the longest label rather than to a fixed width, so the
                                 menu is not mostly empty space. -->
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="MinWidth" Value="0" />
                                    </Style>
                                </StackPanel.Resources>

                                <Button Style="{StaticResource MenuItemButton}"
                                        Content="{loc:T Action.SortByName}"
                                        Command="{Binding SortCommand}" CommandParameter="Name"
                                        Click="OnSortItemClick" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Content="{loc:T Action.SortByDate}"
                                        Command="{Binding SortCommand}" CommandParameter="Date"
                                        Click="OnSortItemClick" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Content="{loc:T Action.SortBySize}"
                                        Command="{Binding SortCommand}" CommandParameter="Size"
                                        Click="OnSortItemClick" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Content="{loc:T Action.SortByPath}"
                                        Command="{Binding SortCommand}" CommandParameter="Path"
                                        Click="OnSortItemClick" />
                                <Separator Margin="6,4" />
                                <Button Style="{StaticResource MenuItemButton}"
                                        Content="{loc:T Action.Reverse}"
                                        ToolTip="{loc:T Action.ReverseHint}"
                                        Command="{Binding SortCommand}" CommandParameter="Reverse"
                                        Click="OnSortItemClick" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- List + drop target -->
                    <Border Grid.Row="1"
                            x:Name="DropZone"
                            Background="{DynamicResource SubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnListDrop"
                            DragOver="OnListDragOver"
                            DragLeave="OnListDragLeave">
                        <Grid>
                            <ListView x:Name="FileList"
                                      ItemsSource="{Binding Files}"
                                      ItemContainerStyle="{StaticResource FileListItem}"
                                      SelectionMode="Extended"
                                      AllowDrop="True"
                                      PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                      MouseMove="OnListMouseMove"
                                      Margin="2">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="{loc:T List.Column.Name}" Width="600">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- The full path, with folders dropped from the middle when the
                                                         column is too narrow, so the drive and the file name stay. -->
                                                    <Grid Margin="4,0,0,0" ToolTip="{Binding FullPath}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   conv:PathEllipsis.Path="{Binding FullPath}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Error}"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   Margin="8,0,0,0"
                                                                   Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{loc:T List.Column.Size}" Width="75">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Size, Converter={StaticResource SizeFormat}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="4,0,0,0" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{loc:T List.Column.Modified}" Width="125">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Modified, Converter={StaticResource DateFormat}}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="4,0,0,0" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{loc:T List.Column.Kind}" Width="95">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding EncodingLabel}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="4,0,0,0" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding HasFiles, Converter={StaticResource NotBoolToVis}}">
                                <TextBlock Text="{loc:T List.DropHint}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{loc:T List.DropHintSub}"
                                           Style="{StaticResource CaptionText}"
                                           MaxWidth="360"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Highlight shown while a drag hovers over the list -->
                            <Border x:Name="DropOverlay"
                                    Background="{DynamicResource DropOverlayBrush}"
                                    BorderBrush="{DynamicResource DropBorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="{Binding SummaryText}"
                               Style="{StaticResource CaptionText}"
                               Margin="4,8,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================== Options
             Both off until turned on, and neither reads a file as text: one drops a BOM, the
             other adds CRLF. Disabled for split archives and other binary files, where either
             would corrupt the result. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10">
            <WrapPanel IsEnabled="{Binding ShowTextOptions}">
                <CheckBox Content="{loc:T Options.EnsureTrailingNewline}"
                          IsChecked="{Binding EnsureTrailingNewline}"
                          Margin="0,0,24,0" />
                <CheckBox Content="{loc:T Options.RemoveInnerBoms}"
                          IsChecked="{Binding RemoveInnerBoms}" />
            </WrapPanel>
        </Border>

        <!-- ============================================== Footer -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{loc:T Output.Label}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               Margin="0,0,10,0" />

                    <TextBox Grid.Column="1"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource BaseButton}"
                            Content="{loc:T Action.Browse}"
                            Command="{Binding BrowseCommand}"
                            IsEnabled="{Binding IsIdle}"
                            Margin="8,0,0,0" />

                    <ComboBox Grid.Column="3"
                              Width="150"
                              ItemsSource="{Binding Conflicts}"
                              SelectedItem="{Binding SelectedConflict}"
                              ItemTemplate="{StaticResource OptionTemplate}"
                              ToolTip="{loc:T Output.OnConflict}"
                              IsEnabled="{Binding IsIdle}"
                              Margin="8,0,0,0" />

                    <Button Grid.Column="4"
                            Style="{StaticResource SubtleButton}"
                            Content="&#x1F4C1;"
                            FontSize="14"
                            ToolTip="{loc:T Action.OpenFolder}"
                            Command="{Binding OpenOutputFolderCommand}"
                            Margin="4,0,0,0" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding Progress}"
                                     Maximum="100"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource BaseButton}"
                                Content="{loc:T Action.Cancel}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}"
                                Content="{loc:T Action.Merge}"
                                Command="{Binding MergeCommand}"
                                IsEnabled="{Binding IsIdle}"
                                MinWidth="150" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
