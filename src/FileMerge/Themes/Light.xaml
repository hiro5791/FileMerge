    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0C4A7E" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SelectionBrush" Color="#E1EDF9" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="#EDF4FC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

    <SolidColorBrush x:Key="DropOverlayBrush" Color="#1A0F6CBD" />
    <SolidColorBrush x:Key="DropBorderBrush" Color="#0F6CBD" />

</ResourceDictionary>
