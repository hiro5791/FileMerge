<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#FAFAFA" />

    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E5E5" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#D0D0D0" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#F5F5F5" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A0A0" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
