<Project Sdk="Microsoft.NET.Sdk">

  <!--
    All of the merging logic lives here, with no dependency on WPF, so it can be exercised
    directly by the test project and reused by any other front end.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FileMerge.Core</AssemblyName>
    <RootNamespace>FileMerge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileMerge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
